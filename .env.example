# To separate your traces from other application
LANGSMITH_PROJECT=new-agent

# Add API keys for connecting to LLM providers, data sources, and other integrations here
# OPENAI_API_KEY=
# LANGSMITH_API_KEY=

# LiveMigrate MCP (OAuth browser login on first use)
MCP_SERVER_URL=https://mcp.livemigrate.ai/api/mcp
MCP_OAUTH_CALLBACK_PORT=3030
MCP_OAUTH_SCOPE=openid profile email offline_access

# RAG practice services (docker compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
ELASTICSEARCH_URL=http://localhost:9200
VOYAGE_API_KEY=
# DEEPSEEK_API_KEY=

# Search UI: uv run search-api  →  http://127.0.0.1:5001

# Braintrust traces for the search API and DeepEval generator tests, and
# named experiments from `uv run rag-eval-braintrust`.
# Project id wins over project name. A gitignored .env.braintrust with
# BRAINTRUST_API_KEY=... also works for local development.
# BRAINTRUST_API_KEY=
# BRAINTRUST_PROJECT=langgraph-mcp
# BRAINTRUST_PROJECT_ID=
